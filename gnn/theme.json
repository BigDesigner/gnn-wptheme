{
	"$schema": "https://schemas.wp.org/wp/6.5/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": false,
		"layout": {
			"contentSize": "1280px",
			"wideSize": "1520px"
		},
		"color": {
			"defaultPalettes": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "accent", "name": "Accent", "color": "#34d399" },
				{ "slug": "ink", "name": "Ink (dark bg)", "color": "#0a0a0b" },
				{ "slug": "surface", "name": "Surface", "color": "#141416" },
				{ "slug": "paper", "name": "Paper (light bg)", "color": "#fafaf9" },
				{ "slug": "foreground", "name": "Foreground", "color": "#f5f5f4" },
				{ "slug": "muted", "name": "Muted", "color": "#9d9da4" },
				{ "slug": "white", "name": "White", "color": "#ffffff" },
				{ "slug": "black", "name": "Black", "color": "#000000" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Manrope",
					"fontFamily": "Manrope, system-ui, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Space Grotesk",
					"fontFamily": "'Space Grotesk', Manrope, system-ui, sans-serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "14px" },
				{ "slug": "medium", "name": "Medium", "size": "17px" },
				{ "slug": "large", "name": "Large", "size": "24px" },
				{ "slug": "x-large", "name": "Extra Large", "size": "38px" },
				{ "slug": "xx-large", "name": "Display", "size": "56px" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "%", "vw", "vh" ],
			"spacingSizes": [
				{ "slug": "30", "name": "1", "size": "clamp(1.5rem, 4vw, 2rem)" },
				{ "slug": "40", "name": "2", "size": "clamp(2rem, 5vw, 3rem)" },
				{ "slug": "50", "name": "3", "size": "clamp(3rem, 6vw, 4.5rem)" },
				{ "slug": "60", "name": "4", "size": "clamp(4rem, 8vw, 6rem)" },
				{ "slug": "70", "name": "5", "size": "clamp(5rem, 10vw, 8rem)" },
				{ "slug": "80", "name": "6", "size": "clamp(6rem, 12vw, 10rem)" }
			]
		}
	}
}
