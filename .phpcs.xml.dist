<?xml version="1.0"?>
<ruleset name="GNN WordPress Theme">
  <description>WordPress coding, security and documentation standards.</description>
  <file>gnn</file>
  <arg name="extensions" value="php"/>
  <arg name="basepath" value="."/>
  <arg name="parallel" value="4"/>
  <config name="minimum_supported_wp_version" value="6.0"/>
  <config name="testVersion" value="7.4-"/>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.I18n">
    <properties><property name="text_domain" type="array"><element value="gnn"/></property></properties>
  </rule>
</ruleset>
